<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/main_bg"
    android:padding="12dp"
    android:fitsSystemWindows="false">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/panel_bg">

            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="{{MAIN_TITLE}}"
    android:textSize="20sp"
    ... />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择游戏"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Spinner
                        android:id="@+id/game_spinner"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/edit_text_bg"/>

                    <Button
                        android:id="@+id/jump_button"
                        android:layout_width="70dp"
                        android:layout_height="42dp"
                        android:text="跳转"
                        android:textSize="13sp"
                        android:background="@drawable/btn_primary"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/fake_app_button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="伪应用"
                    android:textSize="12sp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="#333333"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/hangup_mode_button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="挂机模式"
                    android:textSize="12sp"
                    android:background="@drawable/btn_secondary"
                    android:textColor="#333333"
                    android:layout_marginStart="6dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动登录"
                    android:textSize="13sp"
                    android:textColor="#FFD700"/>

                <CheckBox
                    android:id="@+id/auto_login_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD700"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工作模式"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/sh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_button_bg"
                        android:text="上号模式"
                        android:textColor="#FFD700"
                        android:textSize="12sp"/>

                    <RadioButton
                        android:id="@+id/zh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:button="@drawable/radio_button_bg"
                        android:text="抓号模式"
                        android:textColor="#FFD700"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="屏幕设置"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="首页方向:"
                        android:textSize="12sp"
                        android:textColor="#FFD700"/>

                    <RadioGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/main_portrait_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/radio_button_bg"
                            android:text="竖屏"
                            android:textColor="#FFD700"
                            android:textSize="11sp"/>

                        <RadioButton
                            android:id="@+id/main_landscape_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/radio_button_bg"
                            android:text="横屏"
                            android:textColor="#FFD700"
                            android:textSize="11sp"/>

                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="登录方向:"
                        android:textSize="12sp"
                        android:textColor="#FFD700"/>

                    <RadioGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/agent_portrait_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/radio_button_bg"
                            android:text="竖屏"
                            android:textColor="#FFD700"
                            android:textSize="11sp"/>

                        <RadioButton
                            android:id="@+id/agent_landscape_radio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/radio_button_bg"
                            android:text="横屏"
                            android:textColor="#FFD700"
                            android:textSize="11sp"/>

                    </RadioGroup>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="隐藏应用"
                    android:onClick="hidePackageClicked"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_primary"
                    android:layout_marginEnd="6dp"
                    android:textSize="12sp"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="恢复应用"
                    android:onClick="unhidePackageClicked"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_primary"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btn_open_filter"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:text="过滤器"
                android:textSize="8sp"
                android:padding="0dp"
                android:background="@drawable/btn_secondary"
                android:textColor="#333333"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="16dp"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_secondary"
            android:padding="4dp">

            <Button
                android:id="@+id/tab_file"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="账号文件"
                android:textSize="13sp"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="2dp"/>

            <Button
                android:id="@+id/tab_resource"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="资源列表"
                android:textSize="13sp"
                android:background="@drawable/btn_secondary"
                android:textColor="#333333"
                android:layout_marginStart="2dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/file_content_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="账号文件内容预览"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击操作"
                    android:textSize="10sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#00FFFFFF"
                android:scrollbars="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/refresh_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="刷新"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_primary"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/share_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="分享"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_primary"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resource_content_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="在线资源列表"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/resource_refresh_button"
                    android:layout_width="80dp"
                    android:layout_height="32dp"
                    android:text="刷新"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_primary"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/resource_loading_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/resource_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="加载中..."
                android:textSize="14sp"
                android:textColor="#FFD700"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/resource_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="加载失败，请重试"
                android:textSize="14sp"
                android:textColor="#FF6B6B"
                android:visibility="gone"/>

            <ListView
                android:id="@+id/resource_list_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#FFFF"
                android:dividerHeight="1dp"
                android:background="#00FFFFFF"/>

            <TextView
                android:id="@+id/resource_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="暂无数据"
                android:textSize="14sp"
                android:textColor="#FFD700"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>